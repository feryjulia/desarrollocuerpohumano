 <activities>
  <activity class="@associations.ComplexAssociation" name="ESTRUCTURA DEL CUERPO HUMANO" code="">
   <description />
   <messages>
    <cell border="false" type="initial">
     <style>
      <font family="Georgia" size="17" />
      <color background="0xFF99CC" />
     </style>
     <p>RELACIONA LA IMAGEN CON SU NOMBRE</p>
    </cell>
    <cell type="final">
     <style>
      <font family="Georgia" size="18" />
      <color background="0xFF00CC" />
     </style>
     <p>!LO LOGRASTE!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0xFFCCCC">
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFCCCC" border="true" />
   </settings>
   <cells rows="4" cols="1" cellWidth="200.0" cellHeight="200.0" border="true" id="primary">
    <style />
    <shaper class="@Rectangular" cols="1" rows="4" />
    <cell id="0" image="4_morado_sin_texto.png" />
    <cell image="3_verde_sin_texto.png" />
    <cell image="2_rosa_sin_texto.png" />
    <cell image="1_azul_sin_texto.png" />
   </cells>
   <cells rows="4" cols="1" cellWidth="200.0" cellHeight="200.0" border="true" id="secondary">
    <style />
    <shaper class="@Rectangular" cols="1" rows="4" />
    <cell>
     <style borderStroke="0.7" markerStroke="5.0">
      <color background="0xFFFFFF" />
     </style>
     <p>SISTEMAO DIGESTIVO</p>
    </cell>
    <cell>
     <style borderStroke="0.7" markerStroke="5.0">
      <color background="0xFFFFFF" />
     </style>
     <p>SISTEMA CIRCULATORIO</p>
    </cell>
    <cell>
     <style borderStroke="0.7" markerStroke="5.0">
      <color background="0xFFFFFF" />
     </style>
     <p>SISTEMA MUSCULAR</p>
    </cell>
    <cell>
     <style borderStroke="0.7" markerStroke="5.0">
      <color background="0xFFFFFF" />
     </style>
     <p>SISTEMA OSEO</p>
    </cell>
   </cells>
   <scramble times="31" primary="true" secondary="true" />
   <layout position="AB" />
  </activity>
