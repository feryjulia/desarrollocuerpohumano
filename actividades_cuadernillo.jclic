  <activity class="@textGrid.WordSearch" name="SOPA DE LETRAS CAMBIOS FISICOS DE LA PUBERTAD" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <color background="0xFFFFFF" />
     </style>
     <p>Busca las palabras en la sopa de letras</p>
    </cell>
    <cell type="final">
     <style>
      <color background="0xFFFFFF" />
     </style>
     <p>Lo lograste</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0xFFCCCC">
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFCCFF" border="true" />
   </settings>
   <textGrid rows="8" columns="8" cellWidth="47.0" cellHeight="50.0" border="true">
    <style>
     <color background="0xFFFFFF" />
    </style>
    <text>
     <row>V****A*S</row>
     <row>*O***U*A</row>
     <row>**ZO*T*N</row>
     <row>***S*O*O</row>
     <row>ACNE*E*M</row>
     <row>***P***R</row>
     <row>*CAMBIOO</row>
     <row>*******H</row>
    </text>
   </textGrid>
   <clues>
    <clue id="0">VOZ</clue>
    <clue id="1">ACNE</clue>
    <clue id="2">PESO</clue>
    <clue id="3">HORMONAS </clue>
    <clue id="4">CAMBIO</clue>
   </clues>
  </activity>
